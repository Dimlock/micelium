; Мицелий — цифровой прототип по приложенным правилам.
; Godot 4.5+, без внешних зависимостей.
config_version=5

[application]
config/name="Мицелий — цифровой прототип"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/description="Локальная оцифровка настольной игры «Мицелий». Данные компонентов — заменяемые заглушки."
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/size/min_width=1100
window/size/min_height=700
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_2d=2

[gui]
theme/default_font_multichannel_signed_distance_field=true

[debug]
gdscript/warnings/untyped_declaration=0
